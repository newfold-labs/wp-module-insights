{
  "name": "newfold-labs/wp-module-insights",
  "description": "A Newfold module that handles integration of Insights page.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Newfold Digital",
      "email": "hi@newfold.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "NewfoldLabs\\WP\\Module\\Insights\\": "includes"
    },
    "files": [
      "bootstrap.php"
    ]
  },
  "repositories": {
    "newfold": {
      "type": "composer",
      "url": "https://newfold-labs.github.io/satis/",
      "only": [
        "newfold-labs/*"
      ]
    }
  },
  "require": {
    "newfold-labs/wp-module-data": "^2.9.3",
    "newfold-labs/wp-module-loader": "^1.1.0"
  },
  "require-dev": {
    "newfold-labs/wp-php-standards": "^1.2.3",
    "johnpbloch/wordpress": "@stable",
    "lucatume/wp-browser": "*",
    "phpunit/phpcov": "*"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "scripts": {
    "test": "codecept run wpunit",
    "test-coverage": "codecept run wpunit --coverage wpunit.cov && phpcov merge --php tests/_output/merged.cov --html tests/_output/html tests/_output && echo \"open tests/_output/html/index.html to view the report\""
  },
  "scripts-descriptions": {
    "test": "Run wpunit tests.",
    "test-coverage": "Run wpunit tests with coverage."
  }
}